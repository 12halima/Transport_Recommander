import os
import pandas as pd

def extract_bounding_boxes(root_folder, output_csv="gtfs_bounding_boxes.csv"):
    """
    Parcourt tous les sous-dossiers du root_folder.
    Pour chaque dossier qui contient un stops.txt :
        - lit les coordonnées
        - calcule min/max lat/lon
        - ajoute une ligne au fichier final
    """

    results = []

    for dirpath, _, filenames in os.walk(root_folder):
        if "stops.txt" in filenames:
            stops_path = os.path.join(dirpath, "stops.txt")

            try:
                df = pd.read_csv(stops_path, dtype=str, encoding="utf-8")

                # cast numeric
                df["stop_lat"] = df["stop_lat"].astype(float)
                df["stop_lon"] = df["stop_lon"].astype(float)

                min_lat = df["stop_lat"].min()
                max_lat = df["stop_lat"].max()
                min_lon = df["stop_lon"].min()
                max_lon = df["stop_lon"].max()

                results.append({
                    "source_folder": dirpath,
                    "min_lat": min_lat,
                    "max_lat": max_lat,
                    "min_lon": min_lon,
                    "max_lon": max_lon
                })

            except Exception as e:
                print(f"Erreur lecture {stops_path}: {e}")

    # Convertir en dataframe
    result_df = pd.DataFrame(results)

    # Sauvegarde finale
    result_df.to_csv(output_csv, index=False, encoding="utf-8")

    print("Fichier résumé créé :", output_csv)
    return result_df


# Exécution sur ton Drive
root_folder = "/content/drive/MyDrive/Transport"
df_bbox = extract_bounding_boxes(root_folder)

